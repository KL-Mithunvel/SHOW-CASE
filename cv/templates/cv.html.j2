<title>{{ ctx.person.name.split()[0] }} CV{% if ctx.profile_title %} · {{ ctx.profile_title }}{% endif %}</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&display=swap">
<style>
/* Generated by cv/build.py from cv/templates/cv.html.j2. Edit the template or the data, not this file.
   Layout: A4 sheet on a desk; left date column + right content column, German "Lebenslauf" conventions. Single-theme: it is paper. */
:root {
  --desk: #dfe3e6; --paper: #ffffff;
  --ink: #{{ style.ink }}; --muted: #{{ style.muted }}; --rule: #{{ style.rule }}; --accent: #{{ style.accent }};
  --display: "Archivo", "{{ style.font_heading }}", "Segoe UI", Arial, sans-serif;
  --body: "Source Sans 3", "{{ style.font_body }}", "Segoe UI", Arial, sans-serif;
  color-scheme: light;
}
* { box-sizing: border-box; }
body { background: var(--desk); color: var(--ink); font-family: var(--body);
  padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); padding-block: 24px 48px; }
.sheet { width: 100%; max-width: 794px; margin: 0 auto; background: var(--paper);
  box-shadow: 0 1px 2px rgba(0,0,0,.08), 0 8px 24px rgba(30,45,55,.12);
  padding: 56px 68px 48px; display: flex; flex-direction: column; gap: 16px; font-size: 12.8px; line-height: 1.4; }
header.top { display: grid; grid-template-columns: 1fr auto; gap: 20px; align-items: start; padding-bottom: 14px; border-bottom: 2px solid var(--accent); }
h1 { font-family: var(--display); font-weight: 700; font-size: 28px; line-height: 1.08; margin: 0; color: var(--accent); letter-spacing: -.01em; text-wrap: balance; }
.role { margin: 6px 0 10px; font-size: 14px; font-weight: 600; }
.contact { display: flex; flex-wrap: wrap; gap: 4px 16px; font-size: 12.3px; color: var(--muted); }
.contact span { overflow-wrap: anywhere; }
.contact b { color: var(--ink); font-weight: 600; }
.contact a { color: var(--accent); text-decoration: none; border-bottom: 1px solid var(--rule); }
.photo { width: 104px; aspect-ratio: {{ style.photo_mm.width }} / {{ style.photo_mm.height }}; object-fit: cover; display: block; }
section { display: grid; gap: 7px; }
section.break { margin-top: 28px; padding-top: 28px; border-top: 1px dashed var(--rule); }
h2 { font-family: var(--display); font-weight: 600; font-size: 12.3px; text-transform: uppercase; letter-spacing: .09em;
  color: var(--accent); margin: 0; padding-bottom: 4px; border-bottom: 1px solid var(--rule); }
.row { display: grid; grid-template-columns: 112px 1fr; gap: 14px; }
.when { color: var(--muted); font-size: 12px; font-variant-numeric: tabular-nums; padding-top: 1px; }
.what { min-width: 0; }
.what h3 { margin: 0; font-size: 13.3px; font-weight: 700; }
.org { color: var(--muted); font-style: italic; }
.what ul { margin: 3px 0 0; padding-left: 16px; }
.what li { margin: 1px 0; }
p { margin: 0; }
.sign { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; font-size: 12px; color: var(--muted); margin-top: 32px; }
.sign div { border-top: 1px solid var(--ink); padding-top: 4px; }
@media (max-width: 640px) {
  .sheet { padding: 32px 18px 40px; font-size: 13px; }
  header.top { grid-template-columns: 1fr; }
  .photo { width: 80px; grid-row: 1; }
  .row { grid-template-columns: 1fr; gap: 2px; }
  .when { font-weight: 600; }
  h1 { font-size: 24px; }
}
</style>

<article class="sheet">
  <header class="top">
    <div>
      <h1>{{ ctx.person.name }}</h1>
      {% if ctx.headline %}<p class="role">{{ ctx.headline }}</p>{% endif %}
      <div class="contact">
        {% for label, value, url in ctx.contact %}<span><b>{{ label }}</b> {% if url and not url.startswith("mailto:") %}<a href="{{ url }}">{{ value }}</a>{% else %}{{ value }}{% endif %}</span>
        {% endfor %}
      </div>
    </div>
    {% if photo_uri %}<img class="photo" src="{{ photo_uri }}" alt="Application photo of {{ ctx.person.name }}">{% endif %}
  </header>

  {% for sec in ctx.sections %}
  <section{% if sec.page_break_before %} class="break"{% endif %}>
    <h2>{{ sec.title }}</h2>
    {% if sec.kind == "text" %}
    <p>{{ sec.text }}</p>
    {% else %}
    {% for row in sec.rows %}
    <div class="row">
      {% if sec.kind == "kv" %}
      <div class="when">{{ row.label }}</div><div class="what">{{ row.value }}</div>
      {% elif sec.kind == "languages" %}
      <div class="when">{{ row.name }}</div><div class="what">{{ row.level }}</div>
      {% elif sec.kind == "dated" %}
      <div class="when">{{ row.when }}</div><div class="what">{{ row.text }}{% if row.org %} · <span class="org">{{ row.org }}</span>{% endif %}</div>
      {% else %}
      <div class="when">{{ row.when }}</div>
      <div class="what">
        <h3>{{ row.title }}</h3>
        {% if row.org or row.note %}<span class="org">{{ row.org }}</span>{% if row.note %}{% if row.org %} · {% endif %}{{ row.note }}{% endif %}{% endif %}
        {% if row.bullets %}<ul>{% for b in row.bullets %}<li>{{ b }}</li>{% endfor %}</ul>{% endif %}
      </div>
      {% endif %}
    </div>
    {% endfor %}
    {% endif %}
  </section>
  {% endfor %}

  <div class="sign">
    <div>{{ [ctx.sign.place, ctx.sign.date] | select | join(", ") or "Place, date" }}</div>
    <div>Signature</div>
  </div>
</article>
